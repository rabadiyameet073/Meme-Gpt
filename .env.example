# ── MemeGPT Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your API keys

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:19006"]

# Groq LLM API (free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Emotion Model
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# Vector DB - Qdrant (free cloud at https://cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memes

# Redis Cache (free at https://upstash.com)
REDIS_URL=

# CDN / Object Storage
CDN_BASE_URL=https://cdn.memegpt.com
APP_BASE_URL=http://localhost:3000

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CDN_URL=https://cdn.memegpt.com
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=
